# ====================================================================
# PulseRadar Backend Environment Variables Template (.env.example)
# Copy this file to `.env` and fill in your keys as needed.
# ====================================================================

PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DEBUG=true

DATABASE_URL="sqlite+aiosqlite:///./pulseradar.db"

# Firecrawl API
FIRECRAWL_API_KEY=""
FIRECRAWL_BASE_URL="https://api.firecrawl.dev"

# LLM Providers
LLM_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Platform Credentials
TWITTER_AUTH_TOKEN=""
TWITTER_CT0=""
TWITTER_BEARER_TOKEN=""
FACEBOOK_C_USER=""
FACEBOOK_XS=""
GITHUB_TOKEN=""

MAX_ITEMS_PER_CHANNEL=100
REQUEST_TIMEOUT_SECONDS=30
REDDIT_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) PulseRadar/1.0"
