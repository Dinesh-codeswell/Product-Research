# ====================================================================
# PulseRadar Environment Variables Template (.env.example)
# Copy this file to `.env` and fill in your keys as needed.
# Note: PulseRadar operates 100% zero-auth for Reddit, YouTube, HN,
#       and GitHub out of the box. Additional keys unlock deep web
#       markdown extraction and authenticated crawling.
# ====================================================================

# --- Server & Network ---
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DEBUG=true

# --- Database ---
DATABASE_URL="sqlite+aiosqlite:///./pulseradar.db"

# --- Firecrawl API (Deep Web Markdown Scraping & AI Agent Bundles) ---
# Sign up at https://firecrawl.dev to get your API key.
# Transforms discovered web articles into pristine Markdown and JSON for LLMs.
FIRECRAWL_API_KEY=""
FIRECRAWL_BASE_URL="https://api.firecrawl.dev"

# --- LLM Providers for Synthesis & PRD Studio ---
# Choose: "openai", "anthropic", or "ollama"
LLM_PROVIDER="openai"

# OpenAI Configuration
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Anthropic Configuration
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Local Ollama Configuration (100% Free / Local)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# --- Platform Credentials (Optional for deeper crawling or rate-limit expansion) ---
# Twitter / X Session Cookies (Exported via Cookie-Editor browser extension)
TWITTER_AUTH_TOKEN=""
TWITTER_CT0=""
TWITTER_BEARER_TOKEN=""

# Facebook Session Cookies
FACEBOOK_C_USER=""
FACEBOOK_XS=""

# GitHub Personal Access Token (for higher API rate limits)
GITHUB_TOKEN=""

# --- Ingestion Scope & Timeouts ---
MAX_ITEMS_PER_CHANNEL=100
REQUEST_TIMEOUT_SECONDS=30
REDDIT_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) PulseRadar/1.0"
