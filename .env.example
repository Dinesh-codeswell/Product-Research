# ====================================================================
# PulseRadar Environment Variables Template (.env.example)
# Copy this file to `.env` and fill in your keys as needed.
# Note: PulseRadar operates 100% zero-auth for Reddit, YouTube, HN,
#       and GitHub out of the box. Additional keys unlock deep web
#       markdown extraction and authenticated crawling.
# ====================================================================

# --- Server & Network ---
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DEBUG=true

# --- Database ---
DATABASE_URL="sqlite+aiosqlite:///./pulseradar.db"

# --- Firecrawl API (Deep Web Markdown Scraping & AI Agent Bundles) ---
# Sign up at https://firecrawl.dev to get your API key.
# Transforms discovered web articles into pristine Markdown and JSON for LLMs.
FIRECRAWL_API_KEY=""
FIRECRAWL_BASE_URL="https://api.firecrawl.dev"

# --- LLM Providers for Synthesis & PRD Studio ---
# Choose: "openai", "anthropic", or "ollama"
LLM_PROVIDER="openai"

# OpenAI Configuration
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Anthropic Configuration
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Local Ollama Configuration (100% Free / Local)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# --- YouTube Anti-Bot Bypass (Fixes "Sign in to confirm you're not a bot") ---
# Easiest fix: export your YouTube cookies to a Netscape cookies.txt file (via the
# Cookie-Editor extension) and drop it at backend/data/cookies.txt (auto-detected),
# or point YOUTUBE_COOKIES_FILE at any path. Alternatively paste the raw cookies.txt
# content into YOUTUBE_COOKIES. To borrow cookies straight from an installed browser
# instead (the browser must be fully closed on Windows), set:
YOUTUBE_COOKIES_FROM_BROWSER=""   # e.g. "chrome", "edge", "firefox", "brave"
# Optional: route YouTube traffic through a residential proxy (datacenter IPs get
# bot-challenged far more often than home IPs):
YOUTUBE_PROXY=""

# --- YouTube Whisper ASR (Optional: unlocks audio transcription when captions are disabled) ---
# Groq offers a free tier for whisper-large-v3: https://console.groq.com/keys
# If left empty, the engine falls back to OpenAI Whisper (OPENAI_API_KEY) and finally to
# video chapters / description timestamps so the pipeline never hard-fails.
GROQ_API_KEY=""
WHISPER_PROVIDER="auto"        # "groq" | "openai" | "auto"
WHISPER_MODEL="whisper-large-v3"

# --- Platform Credentials (Optional for deeper crawling or rate-limit expansion) ---
# Twitter / X Session Cookies (Exported via Cookie-Editor browser extension)
TWITTER_AUTH_TOKEN=""
TWITTER_CT0=""
TWITTER_BEARER_TOKEN=""

# Facebook Session Cookies
FACEBOOK_C_USER=""
FACEBOOK_XS=""

# GitHub Personal Access Token (for higher API rate limits)
GITHUB_TOKEN=""

# --- Ingestion Scope & Timeouts ---
MAX_ITEMS_PER_CHANNEL=100
REQUEST_TIMEOUT_SECONDS=30
REDDIT_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) PulseRadar/1.0"
